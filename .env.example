# Server
PORT=8080
ENV=development

# Auth
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRY_HOURS=72

# Database (Nexus platform DB)
DATABASE_URL=postgres://nexus:nexus_secret@localhost:5432/nexus?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────
# LLM Providers — set the keys for providers you have access to
# ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5

GOOGLE_API_KEY=
GOOGLE_DEFAULT_MODEL=gemini-2.5-pro

# ─────────────────────────────────────────────────────────────────
# Offline Cashback Adapter
# Use one of: "db" (read-only replica) or "http" (Ops API)
# ─────────────────────────────────────────────────────────────────
CASHBACK_ADAPTER_MODE=db

# If mode=db: read-only DB connection to cashback database
CASHBACK_DB_URL=postgres://readonly_user:password@cashback-db:5432/cashback_db?sslmode=require

# If mode=http: cashback Ops API endpoint (to be built inside Laravel)
CASHBACK_API_URL=http://localhost/api/agent-ops
CASHBACK_API_KEY=

# ─────────────────────────────────────────────────────────────────
# CORS origins (comma-separated)
# ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
